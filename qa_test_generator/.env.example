# Anthropic API (required)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (required for paywall; app works without these but all requests are "free tier")
# 1. Create a Stripe account, then create a recurring Price (e.g. $9/mo)
# 2. Copy the Price ID here
# 3. For webhooks: stripe listen --forward-to localhost:3000/api/webhook (dev)
#    or create a webhook endpoint in the Stripe dashboard pointing to
#    https://YOUR_DOMAIN/api/webhook, subscribing to checkout.session.completed
#    and customer.subscription.updated / customer.subscription.deleted
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Upstash Redis (required for rate limiting + subscription cache)
# Create a free Redis database at https://console.upstash.com/
# Both the REST URL and REST token are shown in the DB dashboard.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Free tier quota (default: 3 generations per UTC day per anonymous user)
FREE_TIER_DAILY_LIMIT=3

# ScreenshotOne (required for "Capture from URL" feature)
# Sign up at https://screenshotone.com/ (100 free screenshots/month)
# App still runs without this; the URL capture button just errors out.
SCREENSHOTONE_ACCESS_KEY=

# App URL (used to build Stripe redirect URLs)
# Local dev:   http://localhost:3000
# Production:  https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
