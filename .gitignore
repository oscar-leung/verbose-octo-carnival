data/

# Chrome persistent profile (contains session cookies)
.chrome-handshake-profile/

# workflows
playwright.yml

# Un-ignore files that belong to the playwright-portfolio SDET framework
# (the global *.json / playwright.yml rules above exclude them otherwise)
!playwright-portfolio/package.json
!playwright-portfolio/package-lock.json
!playwright-portfolio/tsconfig.json
!.github/workflows/playwright.yml