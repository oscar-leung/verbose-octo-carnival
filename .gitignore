# Virtual environment
venv/
.env/
*.env

# Python cache
__pycache__/
*.py[cod]

# VS Code settings
.vscode/

# OS files
.DS_Store

# Images (if you want to exclude)

# Logs
*.log

# CVS
*.csv

*.json

# Build artifacts
dist/
build/
*.egg-info/

# folders
PythonAnywhere/images/

# Screenshot PNGs generated by automation scripts (login/debug screenshots)
PythonAnywhere/*.png
PythonAnywhere/scripts/*.png


# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# linkedin_runs
linkedin_runs/
runs/

