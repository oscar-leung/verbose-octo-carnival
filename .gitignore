# Virtual environment
venv/
.env/
*.env

# Python cache
__pycache__/
*.py[cod]

# VS Code settings
.vscode/

# OS files
.DS_Store

# Images (if you want to exclude)

# Logs
*.log

# Generated CSV outputs (be explicit, don't blanket-ignore)
data/*.csv
runs/**/*.csv
linkedin_runs/**/*.csv
gmass_contacts_master.csv

# Session cookies / auth JSON (don't blanket-ignore — breaks package.json etc.)
handshake_cookies.json
*cookies*.json
.chrome-handshake-profile/

# Build artifacts
dist/
build/
*.egg-info/

# folders
PythonAnywhere/images/

# Screenshot PNGs generated by automation scripts (login/debug screenshots)
PythonAnywhere/*.png
PythonAnywhere/scripts/*.png


# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# linkedin_runs
linkedin_runs/
runs/

# Old run data files (moved to data/)
data/

# Chrome persistent profile (contains session cookies)
.chrome-handshake-profile/

# workflows
playwright.yml

# Claude Code — keep settings.json, ignore local overrides and worktrees
.claude/worktrees/
.claude/settings.local.json

# Stray screenshots inside the library module (keep .py only)
library/*.png